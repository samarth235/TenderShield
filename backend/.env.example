# Copy to backend/.env and adjust. All settings are optional.

# Where the SQLite database and generated PDFs live (default: backend/var)
# TS_DATA_DIR=./var

# Rule extraction: pattern (offline, deterministic - default) | llm (Claude) | auto (LLM when credentials exist)
TS_EXTRACTOR=pattern
# Claude model used by the LLM extractor
TS_LLM_MODEL=claude-opus-5
# Needed only for TS_EXTRACTOR=llm/auto (or use `ant auth login`)
# ANTHROPIC_API_KEY=

# Bid-document similarity: tfidf (offline - default) | sbert (pip install -r requirements-ml.txt)
TS_EMBEDDING_BACKEND=tfidf
# TS_SBERT_MODEL=all-MiniLM-L6-v2

# Seed for the synthetic dataset and the Isolation Forest
TS_RANDOM_SEED=14

# Comma-separated origins allowed to call the API (React dev server)
TS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
