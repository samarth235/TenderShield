# Copy to backend/.env (local) or set in your host's environment (production).
# Variables marked REQUIRED IN PRODUCTION must be set when TS_ENV=production.

# --- Runtime -----------------------------------------------------------------------
# development | production. Production refuses to start without TS_AUTH_SECRET.
TS_ENV=development

# --- Database ----------------------------------------------------------------------
# REQUIRED IN PRODUCTION: PostgreSQL connection string. Unset = SQLite file in TS_DATA_DIR.
# TS_DATABASE_URL=postgresql://tendershield:change-me@localhost:5432/tendershield
# Where uploaded documents, generated dossiers and (SQLite mode) the database live.
# Use a persistent volume in production.
# TS_DATA_DIR=./var
# SQLite mode only: path of the market (awards) store. Default: $TS_DATA_DIR/market.db
# TS_MARKET_DB=

# --- Authentication ----------------------------------------------------------------
# REQUIRED IN PRODUCTION: random secret (>= 32 chars) that signs session tokens.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# TS_AUTH_SECRET=
# Session lifetime in minutes
TS_SESSION_MINUTES=480
# First administrator, created on start-up only when no users exist. Remove after first boot.
# TS_ADMIN_EMAIL=admin@example.gov.in
# TS_ADMIN_PASSWORD=

# Comma-separated browser origins allowed to call the API. Same-origin deployments need none.
TS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Restructuring engine ----------------------------------------------------------
# Market scope for supplier matching, e.g. India (default: all loaded datasets)
# TS_MARKET_COUNTRIES=India
# Awards older than this many years are ignored when matching suppliers
# TS_RECENT_YEARS=7
# Largest award (INR crore) still treated as an SME-size proxy when no Udyam evidence exists
# TS_SME_PROXY_MAX_AWARD_CR=30
# Directory with capability_classifier.joblib / competition_model.joblib (default: backend/models)
# TS_MODELS_DIR=
# Prozorro raw data used to retrain the competition model (default: data/real/raw/prozorro)
# TS_PROZORRO_DIR=
# Fixed FX rates, INR per unit of currency: TS_FX_<CUR>=<rate>, e.g.
# TS_FX_USD=84

# --- Assurance pipeline ------------------------------------------------------------
# Rule extraction: pattern (offline, deterministic - default) | llm (Claude) | auto (LLM when credentials exist)
TS_EXTRACTOR=pattern
TS_LLM_MODEL=claude-opus-5
# Needed only for TS_EXTRACTOR=llm/auto
# ANTHROPIC_API_KEY=
# Bid-document similarity: tfidf (offline - default) | sbert (pip install -r requirements-ml.txt)
TS_EMBEDDING_BACKEND=tfidf
# TS_SBERT_MODEL=all-MiniLM-L6-v2
TS_RANDOM_SEED=14

# --- Demonstration dataset ----------------------------------------------------------
# The fabricated TN-2026-014 tender is for tests and local rehearsal only. Never enable in production.
TS_ENABLE_DEMO=0

# --- Single-container deployment -----------------------------------------------------
# Directory with the built dashboard (frontend/dist); set by the Dockerfile.
# TS_STATIC_DIR=
